# ==============================================
# Street Arcade — Snake
# Copy this file to .env and fill in the values
# ==============================================

# URL do dashboard/backend. Se este jogo rodar via Docker no MESMO host que
# o dashboard, use http://host.docker.internal:3000 — "localhost" de dentro
# de um container aponta pro próprio container, não pra sua máquina.
BACKEND_URL=http://localhost:3000

# ID do totem cadastrado no dashboard (também é aprendido via UDP em runtime)
TOTEM_ID=

# ── Configurações do jogo ─────────────────────────────────────
# Movimentos da cobra por segundo
SNAKE_SPEED=5
# Pontos por comida
POINTS_PER_FOOD=10
# Movimentos por frame segurando B (boost)
BOOST_MOVES=3
