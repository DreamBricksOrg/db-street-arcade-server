# ==============================================
# Street Arcade — Environment Variables
# Copy this file to .env and fill in the values
# ==============================================

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# MongoDB — se for rodar via `docker compose up` (root docker-compose.yml,
# que já sobe um container mongo), use mongodb://mongo:27017/street-arcade
# (o nome do service na rede do compose). Para Mongo nativo/externo, aponte
# pro host:porta reais.
MONGO_URI=mongodb://localhost:27020/street-arcade

# Redis — mesmo caso acima: use redis://redis:6379 se for usar o container
# redis do docker-compose da raiz.
REDIS_URL=redis://localhost:6379

# UDP Gateway (Totem)
UDP_HOST=127.0.0.1
UDP_PORT=9001

# Session
SESSION_TIMEOUT_MS=300000
SESSION_MAX_PLAYERS=2

# Public URL (used for QR Code generation)
PUBLIC_URL=http://localhost:3000

# n→n: totem embedded as <iframe src="/embed/:totemId"> on public sites
# (each iframe load = its own instance with its own queue, QR and phones)
INSTANCE_GRACE_MS=120000        # how long a closed iframe keeps its sessions
MAX_INSTANCES_PER_IP=20         # open iframes per visitor IP (loopback exempt)
MAX_INSTANCES_PER_TOTEM=2000
TRUST_PROXY=false               # true behind nginx so X-Forwarded-For is the visitor IP
EMBED_FRAME_ANCESTORS=*         # CSP frame-ancestors for /embed (e.g. https://site.com)
# GAMES_DIR=./games
