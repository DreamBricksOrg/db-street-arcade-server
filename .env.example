# ==============================================
# Street Arcade — Environment Variables
# Copy this file to .env and fill in the values
# ==============================================

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# MongoDB — se for rodar via `docker compose up` (root docker-compose.yml,
# que já sobe um container mongo), use mongodb://mongo:27017/street-arcade
# (o nome do service na rede do compose). Para Mongo nativo/externo, aponte
# pro host:porta reais.
MONGO_URI=mongodb://localhost:27020/street-arcade

# Redis — mesmo caso acima: use redis://redis:6379 se for usar o container
# redis do docker-compose da raiz.
REDIS_URL=redis://localhost:6379

# UDP Gateway (Totem)
UDP_HOST=127.0.0.1
UDP_PORT=9001

# Session
SESSION_TIMEOUT_MS=300000
SESSION_MAX_PLAYERS=2

# Public URL (used for QR Code generation)
PUBLIC_URL=http://localhost:3000
