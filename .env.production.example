# ==============================================
# Street Arcade — PRODUCTION environment
# Copy to .env on the server, fill the <…> values, then check it with:
#   npm run ops:check-env
# ==============================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Public HTTPS address (QR codes point here; https also makes the login
# cookie Secure).
PUBLIC_URL=https://<seu-dominio>

# Operator login — REQUIRED. Use a long random value (≥ 16 chars), e.g.:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
# Changing it logs every operator out.
OPERATOR_PASSWORD=<senha-longa-aleatória>

# Behind nginx (nginx.conf sends X-Forwarded-For): per-IP limits must see the
# visitor, not the proxy.
TRUST_PROXY=true

# Root docker-compose.yml service names. For external services, use their
# real host:port instead.
MONGO_URI=mongodb://mongo:27017/street-arcade
REDIS_URL=redis://redis:6379

# Fallback UDP target (each physical totem has its own ip/port in the dashboard)
UDP_HOST=127.0.0.1
UDP_PORT=9001

# Sites allowed to embed the games in an <iframe> (CSP frame-ancestors).
# '*' = any site. Example: https://loja.exemplo.com https://evento.exemplo.com
EMBED_FRAME_ANCESTORS=*

SESSION_TIMEOUT_MS=300000
SESSION_MAX_PLAYERS=2
SESSION_RETENTION_DAYS=90

QUEUE_RESERVE_MS=30000
QUEUE_SWEEP_MS=10000
QUEUE_JOIN_RATE_MAX=8

INSTANCE_GRACE_MS=120000
MAX_INSTANCES_PER_IP=20
MAX_INSTANCES_PER_TOTEM=2000
